load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:extract_cargo_lints.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

# Generated by //tools/protogen; pulled in with include!, so they're compile data, not sources
# (which also keeps them out of the rustfmt check).
GENERATED = glob(["src/gen/*.rs"])

exports_files(
    GENERATED,
    visibility = ["//tools/protogen:__pkg__"],
)

rust_library(
    name = "mori_api",
    srcs = ["src/lib.rs"],
    compile_data = GENERATED,
    lint_config = ":lints",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "mori_api_test",
    size = "small",
    crate = ":mori_api",
    lint_config = ":lints",
    deps = all_crate_deps(normal_dev = True),
)
