load("@rules_python//python:py_test.bzl", "py_test")

exports_files(["requirements_lock.txt"])

# Runs every CUJ feature (spec/cuj) and the harness smoke feature against the real `mori` binary.
py_test(
    name = "e2e_test",
    # Every CUJ runs end to end against real jj repos; slower CI runners need more than the
    # 60 seconds a small test gets.
    size = "medium",
    srcs = [
        "clone_steps.py",
        "conftest.py",
        "disk_steps.py",
        "doctor_steps.py",
        "gc_steps.py",
        "git_steps.py",
        "harness.py",
        "init_steps.py",
        "ls_steps.py",
        "matchers.py",
        "mcp_steps.py",
        "pytest_main.py",
        "remove_steps.py",
        "skills_steps.py",
        "test_features.py",
        "tree_steps.py",
    ],
    data = [
        "features/smoke.feature",
        "//crates/cli:mori",
        "//spec/cuj:features",
        "//third_party/jj",
    ],
    env = {
        "MORI_BIN": "$(rootpath //crates/cli:mori)",
        "MORI_TEST_JJ": "$(rootpath //third_party/jj)",
    },
    main = "pytest_main.py",
    deps = [
        "@pypi//precisely",
        "@pypi//pytest",
        "@pypi//pytest_bdd",
    ],
)
