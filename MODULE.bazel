module(name = "mori", version = "0.0.0")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.3.4")

# The Rust toolchain comes from Bazel, pinned to the same version as rust-toolchain.toml.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.94.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Third-party crates: Cargo.toml and Cargo.lock are only the dependency manifest; Bazel builds.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],  # member crates are found from the workspace
)
use_repo(crate, "crates")

# Python for the end-to-end tests, which run the real binary: a hermetic interpreter and locked
# test dependencies.
# No implicit __init__.py files (deprecated in rules_python; they turn test dirs into packages).
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.13",
    requirements_lock = "//e2e:requirements_lock.txt",
)
use_repo(pip, "pypi")

# jj for tests. mori supports no particular jj version yet; tests run against this one pinned
# release, so CI and every machine test the same jj. To bump it, change the version and the four
# checksums (from the release page).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

JJ_VERSION = "0.45.1"

JJ_RELEASES = {
    "aarch64-apple-darwin": "51ba42e3d0682616f6eb015045bfe45289b396f03511f9897f645ce8e9272743",
    "x86_64-apple-darwin": "6171582d0b5a98a1005cd9643faebff7936812ec264d7968a39d9cef3654a99b",
    "aarch64-unknown-linux-musl": "7349a43dd5a20dbc998b10114daa0ee63d2ab863fb822c7eb6b0ebca5903cc69",
    "x86_64-unknown-linux-musl": "f35438350b5d61963aac5dd74ede510b31d6b9690769d1a6268cf058cc825f72",
}

[
    http_archive(
        name = "jj_" + triple.replace("-", "_"),
        build_file_content = 'exports_files(["jj"])',
        sha256 = sha256,
        urls = ["https://github.com/jj-vcs/jj/releases/download/v{v}/jj-v{v}-{t}.tar.gz".format(
            t = triple,
            v = JJ_VERSION,
        )],
    )
    for triple, sha256 in JJ_RELEASES.items()
]
